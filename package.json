{
  "name": "whisper-gui",
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "initialize": "pnpm install && pnpm --dir frontend install && node scripts/python.mjs initialize",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "cross-env LIVE_SERVER=1 node scripts/python.mjs backend",
    "start": "pnpm _build-frontend && node scripts/python.mjs backend",
    "build": "pnpm _clean:build && pnpm _build-frontend && node scripts/python.mjs package",
    "_build-frontend": "pnpm gen-api && pnpm --dir frontend build",
    "_clean:build": "rimraf dist build frontend_dist",
    "gen-api": "node scripts/python.mjs generate",
    "check-api": "node scripts/python.mjs check"
  },
  "keywords": [
    "pywebview",
    "python",
    "javascript",
    "typescript",
    "react",
    "vite"
  ],
  "author": "Jose L",
  "devDependencies": {
    "cross-env": "10.1.0",
    "rimraf": "6.0.1"
  }
}
